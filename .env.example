# ============================================================
# Horilla HRMS — Environment Configuration
# Copy this file to .env and fill in your own values.
# ============================================================

# ── Django Core ─────────────────────────────────────────────

# Set to False in production
DEBUG=True

# Generate a new secret key at https://djecrety.ir
SECRET_KEY=your-secret-key-here

# Comma-separated list of allowed hosts. Never use "*" in production.
ALLOWED_HOSTS=localhost,127.0.0.1,www.yourdomain.com

# Comma-separated origins for CSRF (required when behind a proxy / HTTPS)
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Django timezone — see https://docs.djangoproject.com/en/stable/ref/settings/#time-zone
TIME_ZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────
# Option A — single DATABASE_URL (uncomment and fill in)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Option B — individual fields (used when DATABASE_URL is not set)
DB_INIT_PASSWORD=change-me-to-a-strong-random-string
DB_ENGINE=django.db.backends.postgresql
DB_NAME=horilla_main
DB_USER=horilla
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ── GCP Storage (optional) ───────────────────────────────────
# Uncomment and fill in if you want to store media files on GCS.
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GS_BUCKET_NAME=your-gcp-bucket-name
# DEFAULT_FILE_STORAGE=horilla.horilla_backends_gcp.PrivateMediaStorage
# MEDIA_URL=https://storage.cloud.google.com/your-gcp-bucket-name/media
# MEDIA_ROOT=https://storage.cloud.google.com/your-gcp-bucket-name/media
# NAMESPACE=private

# ── SMTP / Email ─────────────────────────────────────────────
# Outgoing mail relay used for payslip / onboarding / helpdesk emails.
# Leave EMAIL_HOST empty to disable outbound mail entirely.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=change-me
# Falls back to EMAIL_HOST_USER if unset
DEFAULT_FROM_EMAIL=user@example.com

# ── Supported DATABASE_URL Schemes ───────────────────────────
# PostgreSQL:              postgres[ql]://  or  p[g]?sql://
# PostGIS:                 postgis://
# MySQL:                   mysql://  or  mysql2://
# MySQL (GIS):             mysqlgis://
# MySQL Connector Python:  mysql-connector://
# SQLite:                  sqlite://
# SpatiaLite (GeoDjango):  spatialite://
# Oracle:                  oracle://
# Microsoft SQL Server:    mssql://
# PyODBC:                  pyodbc://
# Amazon Redshift:         redshift://
# LDAP:                    ldap://
